&lt;li&gt;
&lt;p&gt;2025: 13/2&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;2024: 37/0&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;&lt;a href=&#34;https://kb.isc.org/docs/cve-2025-40776&#34; target=&#34;_blank&#34; rel=&#34;noopener&#34;&gt;BIND&lt;/a&gt;: &lt;a href=&#34;https://cve.mitre.org/cgi-bin/cvename.cgi?name=CVE-2025-40776&#34; target=&#34;_blank&#34; rel=&#34;noopener&#34;&gt;CVE-2025-40776&lt;/a&gt;(高危) &lt;a href=&#34;https://www.cnnvd.org.cn/&#34; target=&#34;_blank&#34; rel=&#34;noopener&#34;&gt;CNNVD-202507-2228&lt;/a&gt;(高危)&lt;/strong&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;&lt;a href=&#34;https://docs.powerdns.com/recursor/security-advisories/powerdns-advisory-2025-04.html&#34; target=&#34;_blank&#34; rel=&#34;noopener&#34;&gt;PowerDNS&lt;/a&gt;: &lt;a href=&#34;https://cve.mitre.org/cgi-bin/cvename.cgi?name=CVE-2025-30192&#34; target=&#34;_blank&#34; rel=&#34;noopener&#34;&gt;CVE-2025-30192&lt;/a&gt;(高危) &lt;a href=&#34;https://www.cnnvd.org.cn/&#34; target=&#34;_blank&#34; rel=&#34;noopener&#34;&gt;CNNVD-202507-2635&lt;/a&gt;(高危)&lt;/strong&gt;&lt;/p&gt;
